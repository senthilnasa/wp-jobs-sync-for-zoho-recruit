<?xml version="1.0"?>
<ruleset name="Jobs Sync for Zoho Recruit">
	<description>WordPress coding standards for the plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<!-- Generated by @wordpress/scripts; its name is dictated by the build. -->
	<exclude-pattern>/blocks/*/build/*</exclude-pattern>
	<exclude-pattern>/.wordpress-org/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- The plugin ships no filesystem writes that need WP_Filesystem beyond
		     the settings import, which already uses it. -->
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_fopen"/>

		<!--
			bin/oauth-test.php runs standalone, without WordPress loaded, which
			is the whole point of it: it proves a Client ID, secret and scope
			list work before the plugin is anywhere near them. So it cannot call
			esc_html() or the other WordPress helpers this ruleset requires, and
			measuring it against them reports noise rather than defects. PHP
			compatibility below still applies to it, and so does php -l.
		-->
		<exclude-pattern>/bin/oauth-test\.php$</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="jobs-sync-for-zoho-recruit"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="jszr"/>
				<element value="JSZR"/>
				<element value="JobsSyncForZohoRecruit"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
	</rule>

	<!--
		The development harnesses in bin/ are single-file CLI tools, not shipped
		code, and one of them needs a small class next to its functions. That is
		the only rule relaxed for them; everything else still applies.
	-->
	<rule ref="Universal.Files.SeparateFunctionsFromOO">
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>

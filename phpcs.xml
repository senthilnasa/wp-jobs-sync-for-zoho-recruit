<?xml version="1.0"?>
<ruleset name="Jobs Sync for Zoho Recruit">
	<description>WordPress coding standards for the plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<!-- Generated by @wordpress/scripts; its name is dictated by the build. -->
	<exclude-pattern>/blocks/*/build/*</exclude-pattern>
	<exclude-pattern>/.wordpress-org/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- The plugin ships no filesystem writes that need WP_Filesystem beyond
		     the settings import, which already uses it. -->
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_fopen"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="jobs-sync-for-zoho-recruit"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="jszr"/>
				<element value="JSZR"/>
				<element value="JobsSyncForZohoRecruit"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
